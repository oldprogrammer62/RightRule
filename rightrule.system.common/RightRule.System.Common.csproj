<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <!-- optional: suppress missing XML warnings -->
  </PropertyGroup>

  <!-- Copy common library to Custom Operators -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy $(TargetDir)\$(AssemblyName).dll C:\Development\BeSoft\RightRule\operator.exists\RightRule.Operator.Common\ /Y /I /E" />
  </Target>

</Project>
