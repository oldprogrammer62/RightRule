<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>RightRule.System.Common</PackageId>
    <Version>1.0.1-beta.3</Version>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Authors>Mark Belton</Authors>
    <Description>RightRule Common provides details to support the RightRule system.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="licenses\LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <!-- optional: suppress missing XML warnings -->
  </PropertyGroup>

  <!-- Copy common library to Custom Operators -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy $(TargetDir)\$(AssemblyName).dll C:\Development\BSoft\RightRule\operator.exists\RightRule.Operator.Common\ /Y /I /E" />
    <Exec Command="xcopy $(TargetDir)\$(AssemblyName).dll C:\Development\BSoft\RightRule\operator.dayofweek\RightRule.Operator.Common\ /Y /I /E" />
    <Exec Command="xcopy $(TargetDir)\$(AssemblyName).dll C:\Development\BSoft\RightRule\operator.strequals\RightRule.Operator.Common\ /Y /I /E" />
  </Target>

</Project>
