<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>RightRule</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Version>1.0.0</Version>
    <Authors>Mark Belton</Authors>
    <Description>RightRule allows you to externalise and configure business rules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="\" />
    <None Include="licenses\LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
  
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <!-- optional: suppress missing XML warnings -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\rightrule.system.common\RightRule.System.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RightRule.dll.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Licenses\" />
    <Folder Include="Docs\" />
    <Folder Include="OperatorLoader\" />
  </ItemGroup>

  <!-- Reference the Executable Project -->

  <!-- Target to copy the executable build output into the NuGet tools folder -->
  <Target Name="CopyExecutableToTools" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_ExecutableFiles Include="..\RightRule_SyntaxChecker\bin\$(Configuration)\$(TargetFramework)\publish\**\*.*" />
      <None Include="@(_ExecutableFiles)">
        <Pack>true</Pack>
        <PackagePath>tools/$(TargetFramework)/any/%(RecursiveDir)%(FileName)%(Extension)</PackagePath>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

</Project>
